    <EmbeddedResource Include="../../shaders/native/gtao/*.comp;../../shaders/native/gtao/*.glsl">
      <LogicalName>shaders-vk/gtao/%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="../../shaders/native/occlusion/*.comp">
      <LogicalName>shaders-vk/occlusion/%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
    <!-- The native include set, embedded so a pack source compiles against the same includes the shipped
         programs were built from; ShaderPackLibrary materializes them into the pack build tree. -->
